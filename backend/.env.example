# ===== Server =====
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# ===== Database =====
DATABASE_URL=postgresql://library:library@localhost:5432/library

# ===== JWT =====
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Password reset =====
# Base URL used in emailed reset links
# Base URL used in emailed links (password reset). Must point at the FRONTEND,
# not the API — the reset page lives at /reset-password in the React app.
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_TTL_MIN=60

# ===== Email (SMTP) =====
# Set MAIL_TRANSPORT=json to log emails to console instead of sending (dev)
MAIL_TRANSPORT=json
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Library <noreply@library.local>"

# ===== Library policy =====
# Loan period in days, per-category override supported in DB
DEFAULT_LOAN_PERIOD_DAYS=14
MAX_RENEWALS=2
FINE_RATE_PER_DAY=0.50
OVERDUE_FREE_GRACE_DAYS=0
MAX_OVERDUE_ITEMS_BEFORE_SUSPEND=2
MAX_UNPAID_FINE_BEFORE_SUSPEND=10.00
SUSPENSION_DAYS=14
HOLD_AVAILABLE_GRACE_DAYS=3
